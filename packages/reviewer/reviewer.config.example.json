{
  "db": "./agentfactory.db",
  "excludeWorkspaces": ["agent-demo"],
  "engine": "codex",
  "reviewers": [
    { "engine": "claude", "model": "claude-fable-5-1" },
    { "engine": "codex", "model": "gpt-6-astra", "reasoningEffort": "medium" }
  ],
  "pollSeconds": 60,
  "consensus": { "enabled": true, "totalMinutes": 30, "maxPromptChars": 500000 },
  "maxConcurrent": 1,
